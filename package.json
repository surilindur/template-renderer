{
  "name": "@idsm-src/template-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Library for rendering RDF terms into HTML visualisations using EJS term templates, the Eta template engine, and Comunica query engine.",
  "homepage": "https://github.com/idsm-src/template-renderer",
  "bugs": {
    "url": "https://github.com/idsm-src/template-renderer/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idsm-src/template-renderer.git"
  },
  "files": [
    "lib/*.d.ts",
    "lib/*.js",
    "lib/*.js.map"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format": "oxfmt",
    "lint": "oxlint",
    "test": "vitest run --project node",
    "prepack": "yarn run build"
  },
  "dependencies": {
    "@comunica/types": "^5.0.0",
    "@traqula/algebra-sparql-1-2": "^1.0.0",
    "@traqula/algebra-transformations-1-2": "^1.0.0",
    "@traqula/generator-sparql-1-2": "^1.0.0",
    "@traqula/parser-sparql-1-2": "^1.0.0",
    "eta": "^4.0.0",
    "imurmurhash": "^0.1.0",
    "rdf-data-factory": "^2.0.0"
  },
  "devDependencies": {
    "@rdfjs/types": "^2.0.0",
    "@types/imurmurhash": "^0.1.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "asynciterator": "^3.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.0.0",
    "playwright": "^1.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
